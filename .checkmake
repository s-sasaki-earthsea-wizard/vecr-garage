# ============================================================
# checkmake 設定ファイル
# Makefile lint ルールのカスタマイズ
# ============================================================

# maxbodylength: ターゲット本体の行数制限を無効化
# 理由: プロジェクト固有のhelpターゲットは複雑になることがあり、厳密な制限は不要
[maxbodylength]
disabled = true

# minphony: 最小限の必須ターゲット (all, clean, test) を無効化
# 理由: このプロジェクトはDockerベースで独自のターゲット構成を持つため、標準的なターゲットは不要
[minphony]
disabled = true
